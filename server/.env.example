# Copia in server/.env. Non committare il file vero.
PORT=8787
# Ascolto solo in locale. Per esporre il processo: HOST=0.0.0.0
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:8787
NODE_ENV=development
# 1 = include il link di verifica nella risposta JSON finché la posta non è pronta. In produzione lascia 0.
ALLOW_DEV_LINKS=1

# Casella IONOS prevista (info@ / noreply@biokinetiq.eu). Vuoto = nessun invio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@biokinetiq.eu

# Stripe SOLO test. Una chiave sk_live_ viene rifiutata. Nessun prezzo viene creato dal server.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ATHLETE_MONTH=
STRIPE_PRICE_ATHLETE_YEAR=
STRIPE_PRICE_COACH_MONTH=
STRIPE_PRICE_COACH_YEAR=

# Prezzi in centesimi e durata della prova. Il prezzo Athlete deciso è 799 (7,99 €).
ATHLETE_MONTH_CENTS=799
ATHLETE_YEAR_CENTS=8789
ATHLETE_TRIAL_DAYS=30
COACH_MONTH_CENTS=1499
COACH_YEAR_CENTS=16489
COACH_TRIAL_DAYS=30

# Quota coach, spenta di default. 1 = registro manuale (nessun pagamento).
# 150 = 1,50 € per allievo pagante al mese. Non usa Stripe Connect.
REVENUE_SHARE=0
REVENUE_SHARE_CENTS=150
