# Copia in server/.env. Non committare il file vero.
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
NODE_ENV=development
# 1 = include il link di verifica nella risposta JSON finché la posta non è pronta. In produzione lascia 0.
ALLOW_DEV_LINKS=1

# Casella IONOS prevista (info@ / noreply@biokinetiq.eu). Vuoto = nessun invio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@biokinetiq.eu

# Stripe SOLO test. Una chiave sk_live_ viene rifiutata. Nessun prezzo viene creato dal server.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ATHLETE_MONTH=
STRIPE_PRICE_ATHLETE_YEAR=
STRIPE_PRICE_COACH_MONTH=
STRIPE_PRICE_COACH_YEAR=
